# Скопируйте этот файл в .env и заполните свои значения.
# .env НЕ попадает в Git (см. .gitignore) — секреты только здесь.

# --- Экономика (Этап 4) ---
# Стоимость минуты простоя, ₽. Формула: минуты × это значение.
COST_PER_MINUTE=750

# --- Event Engine ---
# Секунд без изменений, прежде чем простой подтвердится.
DOWNTIME_THRESHOLD_SECONDS=30

# --- Контролируемая зона (ROI) ---
# Координаты нормализованы: 0.0–1.0 от размера кадра, поэтому зона
# работает при любом разрешении камеры.
#
# Значения по умолчанию расширены вверх после проверки на демо-роликах:
# рабочие стоят в ВЕРХНЕЙ половине кадра, а зона, начинавшаяся с 0.35,
# проходила под ними — человека было видно, но «в зоне» он не был.
# Под свой план цеха поправьте эти четыре числа.
ROI_LEFT=0.15
ROI_TOP=0.12
ROI_RIGHT=0.90
ROI_BOTTOM=0.80

# --- Детекция человека (YOLO) ---
# Главный компромисс системы: точность против скорости.
# Размер входа влияет сильнее выбора модели — на далёком плане цеха
# рабочий занимает ~40 пикселей по высоте.
#
# Замер на демо-роликах (доля кадров, где найден рабочий;
# 2 ядра CPU, без видеокарты):
#
#   YOLO_MODEL   YOLO_IMGSZ   найден   мс/кадр
#   yolov8n.pt         416      ~5 %      ~900    (было по умолчанию)
#   yolov8n.pt         640        23 %     1720
#   yolo26n.pt         640        31 %     1461
#   yolo26n.pt         960        62 %     2138   ← по умолчанию
#   yolo26s.pt         960        92 %     5106
#
# Быстрее всего — yolo26n@640, точнее всего — yolo26s@960, но он
# втрое тяжелее. Если скорость важнее точности, поставьте 640.
YOLO_MODEL=yolo26n.pt
YOLO_IMGSZ=960
YOLO_CONFIDENCE=0.35

# Куда ultralytics кладёт настройки и веса модели. Переменная
# читается библиотекой ultralytics напрямую, а не приложением.
# На сервере она обязательна: systemd-юнит работает с ProtectHome=true,
# то есть каталог пользователя /home/promvizor недоступен, и без неё
# первая же попытка скачать веса упадёт с ошибкой записи. Путь должен
# лежать в каталоге данных — он единственный доступный для записи.
# Локально на Windows значение не нужно: там и так всё пишется рядом.
#YOLO_CONFIG_DIR=/opt/promvizor/data/.config/ultralytics

# --- Камера ---
CAMERA_ID=1

# --- Источник видео: demo | webcam | rtsp | synthetic ---
# Это СТАРТОВЫЙ режим — тот, что будет выбран при первом запуске.
# Потом его можно переключить в настройках Dashboard, и выбор сохранится.
DEFAULT_SOURCE=demo
# Запретить переключение из интерфейса (контейнер, развёртывание).
# Оставьте пустым, если выбор в настройках нужен.
FORCED_CAMERA_MODE=
# Номер веб-камеры: 0 — первая
WEBCAM_INDEX=0
# URL реальной IP-камеры (для источника RTSP)
RTSP_URL=rtsp://user:password@192.168.1.10:554/stream

# --- База данных (Этап 5) ---
DATABASE_PATH=promvizor.db

# --- API (Этап 6) ---
# CLI `uvicorn` порт из переменной НЕ читает — указывайте --port.
API_HOST=127.0.0.1
API_PORT=8000
# Источники через запятую. Пусто — разрешить любой (удобно для
# локального Dashboard из файла). Для рабочего сервера задайте явно.
API_CORS_ORIGINS=

# --- Telegram Bot (зона ответственности Gasun) ---
# Токен от @BotFather. Храните его только здесь: файл .env не попадает в Git.
TELEGRAM_BOT_TOKEN=
# Куда слать уведомления. Для группы — вида -1001234567890,
# для личной переписки — ваш числовой id.
TELEGRAM_CHAT_ID=
# Адрес backend'а, у которого бот спрашивает данные. Обычный локальный
# запуск — 127.0.0.1:8000; на другой машине укажите IP сервера.
TELEGRAM_API_URL=http://127.0.0.1:8000
# Как часто бот опрашивает backend в поисках новых событий, сек.
TELEGRAM_POLL_SECONDS=10
