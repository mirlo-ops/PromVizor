# Секреты
.env

# OpenCode: локальная конфигурация, содержит apiKey провайдера
opencode.json
opencode.jsonc

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# База данных
*.db
# Служебные файлы SQLite в режиме WAL — создаются рядом с *.db
*.db-wal
*.db-shm

# Курсор Telegram-бота: последний прочитанный id события. Локальное
# состояние конкретной машины, при переносе бот пропустит историю.
telegram_cursor.json

# Выбранный режим камеры (меняется из настроек Dashboard)
camera_mode.json

# Модели и артефакты (весят десятки мегабайт, качаются автоматически)
*.pt
*.onnx
*.engine
runs/

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
